# Copy to .env before running `docker compose up`.
# Every value below is a placeholder; generate real secrets with:
#   openssl rand -base64 48

# --- PostgreSQL (authoritative store) ---
POSTGRES_DB=kallalai
POSTGRES_USER=kallalai
POSTGRES_PASSWORD=replace-with-a-long-random-password

# --- API ---
# development keeps the demo/local stack runnable without live Firebase or
# Veriff credentials. Set production only when every credential below is real.
NODE_ENV=development
LOG_LEVEL=info
API_PORT=8090
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
METRICS_TOKEN=
TRUST_PROXY=true
DEMO_MODE=true
CORS_ORIGINS=http://127.0.0.1:7357,http://localhost:7357,http://127.0.0.1:7358,http://localhost:7358,http://localhost:5173,http://127.0.0.1:8090
AUTO_MIGRATE=true

# --- Web edge ---
WEB_PORT=8088

# --- Google / Firebase sign-in (required when NODE_ENV=production) ---
FIREBASE_PROJECT_ID=

# --- Veriff hosted identity verification (required when NODE_ENV=production) ---
VERIFF_BASE_URL=
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=

# --- Supabase (optional hosted backend) ---
# Leave blank to keep the bundled PostgreSQL container.
# Client-safe publishable key, e.g. sb_publishable_...
SUPABASE_PUBLISHABLE_KEY=
# 20-character project ref from https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=
SUPABASE_URL=
# Server-only; never ship this to the Flutter client.
SUPABASE_SECRET_KEY=
# Dashboard -> Connect -> Connection string (Transaction/Session pooler).
SUPABASE_DB_URL=
# Or let the API build it from these parts (password is percent-encoded).
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=
SUPABASE_DB_NAME=postgres

# --- Cache (never authoritative) ---
REDIS_MAXMEMORY=256mb

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# --- Backups ---
BACKUP_RETENTION_DAYS=14
