NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Production: set a PostgreSQL/PostGIS connection string.
# Leave empty to use the local PGlite engine (no Docker required).
DATABASE_URL=
PGLITE_PATH=./.data/pglite
AUTO_MIGRATE=true
FIREBASE_PROJECT_ID=your-firebase-project-id
# Configure only after creating a Veriff integration and decision webhook.
# VERIFF_BASE_URL=https://<your-veriff-integration-base-url>
# VERIFF_API_KEY=<server-side-integration-api-key>
# VERIFF_SHARED_SECRET=<server-side-webhook-signing-secret>

# --- Supabase (optional hosted backend) ---
# Client-safe publishable key from Dashboard -> Settings -> API Keys.
# Supabase is replacing the legacy `eyJ...` anon JWT with sb_publishable_...
SUPABASE_PUBLISHABLE_KEY=
# The 20-character project ref from https://<project-ref>.supabase.co.
# Setting it derives SUPABASE_URL; paste the full URL instead for custom domains.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
# Server-only. Never expose to the Flutter client or commit it to a public repo.
# SUPABASE_SECRET_KEY=sb_secret_...
#
# EITHER paste the full connection string from Dashboard -> Connect:
# When present, the API uses Supabase Postgres for ALL durable state.
SUPABASE_DB_URL=
# OR supply the parts and the API assembles the URL (password is escaped for
# you, which matters when it contains # or @). Requires PROJECT_REF above.
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=
SUPABASE_DB_NAME=postgres
# Platform admin, bootstrapped/renamed/rotated by `npm run supabase:setup`.
# The sign-in ID is the part before @ (e.g. novacane232); the API accepts
# either the ID or the full email. Change the password here and re-run setup
# to rotate it and revoke old sessions. Never commit real values.
SUPABASE_ADMIN_EMAIL=
SUPABASE_ADMIN_PASSWORD=

# Use long random values outside local development.
JWT_ACCESS_SECRET=change-me-to-a-long-random-value
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

CORS_ORIGINS=http://127.0.0.1:7357,http://localhost:7357,http://localhost:5173
# REDIS_URL=redis://localhost:6379
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
# METRICS_TOKEN=change-me-metrics-token
TRUST_PROXY=false
DEMO_MODE=true

# Force-update gate: clients sending X-App-Version below this get 426.
# Leave unset to accept every app version.
# MIN_APP_VERSION=1.0.0
# Kill switch: while true, /v1 answers 503 (app/config stays reachable).
MAINTENANCE_MODE=false
