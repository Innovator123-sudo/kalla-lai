# Optional host-level TLS listener.
#
# The default deployment terminates TLS at the load balancer or Kubernetes
# ingress. Use this file only when nginx itself must serve HTTPS. It is not
# loaded automatically because conf.d only includes *.conf.
#
# The unprivileged nginx image cannot bind ports below 1024 without
# CAP_NET_BIND_SERVICE; this listener uses 8443. Map 443 -> 8443 at the edge.
#
# Mount:
#   /etc/nginx/certs/tls.crt
#   /etc/nginx/certs/tls.key

server {
  listen 8080;
  server_name _;
  return 308 https://$host$request_uri;
}

server {
  listen 8443 ssl;
  http2 on;
  server_name _;

  ssl_certificate     /etc/nginx/certs/tls.crt;
  ssl_certificate_key /etc/nginx/certs/tls.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # Keep the same locations as default.conf. In a real deployment, copy them
  # here or include the shared location file so the two listeners cannot drift.
}
